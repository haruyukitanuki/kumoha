{
  "name": "@tanuden/kumoha",
  "version": "1.0.0",
  "description": "Rudolf-native theming engine client for Tanuden TIMS",
  "license": "LGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "check:types": "attw --pack ."
  },
  "dependencies": {
    "dequal": "^2.0.3",
    "socket.io-client": "^4.8.1"
  },
  "peerDependencies": {
    "@tanuden/rudolf": ">=0.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@tanuden/rudolf": "^0.1.1",
    "@types/node": "^24.1.0",
    "vite": "^7.0.6",
    "vite-plugin-dts": "^4.5.4"
  }
}
