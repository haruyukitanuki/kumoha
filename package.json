{
  "name": "kumoha",
  "version": "1.0.0",
  "private": true,
  "description": "Tanuden Kumoha theming engine — monorepo (Rudolf-native core + React bindings)",
  "workspaces": [
    "packages/core",
    "packages/react"
  ],
  "scripts": {
    "build": "npm run build -w @tanuden/kumoha && npm run build -w @tanuden/kumoha-react",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --config .prettierrc.cjs --write './**/*.{ts,tsx,js,jsx,cjs,json,yml,yaml}'",
    "format:check": "prettier --config .prettierrc.cjs --check './**/*.{ts,tsx,js,jsx,cjs,json,yml,yaml}'",
    "check:types": "npm run check:types --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
